{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MarketData": {
    "Provider": "Synthetic",
    "Mode": "Streaming",
    "PollingIntervalSeconds": 5
  },
  "SyntheticMarketData": {
    "Symbols": [ "AAPL", "MSFT", "NVDA", "TSLA", "AMZN" ],
    "IntervalMilliseconds": 1000,
    "Seed": 42
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ClientId": "marketpulse-api",
    "NormalizedTopicPartitions": 6,
    "ReplicationFactor": 1,
    "FeatureProcessorGroupId": "marketpulse-feature-processor",
    "RealtimeGroupId": "marketpulse-api-anomalies"
  },
  "Redis": {
    "ConnectionString": "localhost:6379,abortConnect=false,connectTimeout=2000"
  },
  "SignalR": {
    "AllowedOrigins": [ "http://localhost:5173" ],
    "UseRedisBackplane": true
  },
  "Postgres": {
    "ConnectionString": "Host=localhost;Port=5432;Database=marketpulse;Username=marketpulse;Password=marketpulse"
  },
  "AnomalyDetection": {
    "RuleVersion": "v1",
    "MinScoreToRecord": 40
  },
  "Replay": {
    "RootDirectory": "samples",
    "CsvFile": "replay-aapl.csv",
    "DelayMilliseconds": 0
  },
  "TwelveData": {
    "BaseUrl": "https://api.twelvedata.com/",
    "ApiKey": "",
    "Interval": "1min"
  }
}
